# Copy to deploy/home/.env and fill in. Never commit the real file.

# Your Gemini key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Your Vercel website address, e.g. https://ai-interview-evaluation.vercel.app
# (comma-separate several). The API only accepts browser calls from these.
CORS_ORIGINS=https://your-project.vercel.app

# Long random strings (any value; keep them private)
POSTGRES_PASSWORD=change-me-to-a-long-random-string
RUNNER_TOKEN=change-me-to-another-long-random-string

# Firebase project used for sign-in
FIREBASE_PROJECT_ID=ai-evaluation-40c8a

# Speech-to-text model: base.en (about 1 GB RAM) or small.en (more accurate, about 2 GB RAM)
STT_MODEL=base.en

# Port for checking the API from this computer only (http://127.0.0.1:8000/api/health)
API_PORT=8000

# Standard Interview knowledge verification
COUNTER_CHEATING_ENABLED=true
COUNTER_CHEATING_THRESHOLD=60
COUNTER_CHEATING_MAX_CHALLENGES=2

# The only account that may open the usage overview (/admin). Both must
# match the signed-in account; leave empty to turn the overview off.
ADMIN_UID=
ADMIN_EMAIL=
