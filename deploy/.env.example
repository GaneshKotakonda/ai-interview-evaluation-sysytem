# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public hostname of the API. Point its DNS A record at the server first.
# No domain yet? Use <server-ip>.sslip.io, e.g. 203.0.113.10.sslip.io
API_DOMAIN=api.example.com

# Browser origin(s) of the deployed frontend (comma-separated)
CORS_ORIGINS=https://ai-evaluation-40c8a.web.app,https://ai-evaluation-40c8a.firebaseapp.com

# PostgreSQL (runs in its own container; never exposed publicly)
POSTGRES_DB=interviews
POSTGRES_USER=interview
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# AI
GEMINI_API_KEY=
FIREBASE_PROJECT_ID=ai-evaluation-40c8a

# Speech-to-text: base.en (fast, ~1 GB RAM) or small.en (more accurate, ~2 GB RAM)
STT_PROVIDER=whisper
STT_MODEL=base.en
# Spoken questions: piper (local neural voice) or off (browser voice)
TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
MAX_UPLOAD_MB=200
# Whole-interview recording limit
MAX_SESSION_RECORDING_MB=800
# Leaving the interview (fullscreen exit, tab/app switch) this many times ends it
PROCTORING_MAX_VIOLATIONS=3
# Seconds outside the interview (another tab, window or app) that end it at once
PROCTORING_MAX_AWAY_SECONDS=5
# Identity checks (enrolled face + voice compared during the interview): on | off
IDENTITY_CHECKS=on
# Shared secret between the API and the code runner container (long random string)
RUNNER_TOKEN=change-me-to-another-long-random-string
