# Frontend for the local Docker stack: builds the React app, then serves it
# with nginx, which also forwards /api to the backend (same origin, so no
# CORS setup). Build from the repository root (see deploy/local/docker-compose.yml).
FROM node:22-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.js postcss.config.js tailwind.config.js ./
COPY src ./src
# "/" makes the app call the same address it was loaded from (nginx forwards /api).
ENV VITE_API_BASE_URL=/
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/local/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
