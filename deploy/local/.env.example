# Copy to deploy/local/.env and fill in GEMINI_API_KEY. Never commit the real file.

# Your own free key from https://aistudio.google.com/apikey
# Without it the app still runs, but questions come from a fixed bank and grading is approximate.
GEMINI_API_KEY=

# Port the website is served on: http://localhost:8080
WEB_PORT=8080

# Local database (only reachable inside Docker). Any value works; change it if you like.
POSTGRES_PASSWORD=local-dev-password
# Shared secret between the API and the code-runner container. Any value works.
RUNNER_TOKEN=local-runner-token

# Firebase project used for sign-in (its public web config is built into the app).
FIREBASE_PROJECT_ID=ai-evaluation-40c8a

# Speech-to-text model: base.en (about 1 GB RAM) or small.en (more accurate, about 2 GB RAM)
STT_MODEL=base.en

# Standard Interview knowledge verification (uses scheduled turns)
COUNTER_CHEATING_ENABLED=true
COUNTER_CHEATING_THRESHOLD=60
COUNTER_CHEATING_MAX_CHALLENGES=2
