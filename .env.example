# Copy to .env (repository root) for the Vite frontend. Never commit the real file.
VITE_API_BASE_URL=http://localhost:8000

# Optional: point the app at your own Firebase project.
# When unset, the project's existing public Firebase web config is used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
