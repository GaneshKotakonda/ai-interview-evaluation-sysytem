# Copy to backend/.env and fill in. Never commit the real file.

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
GEMINI_API_KEY=

# Optional (defaults shown)
GEMINI_QUESTION_MODEL=gemini-flash-lite-latest
GEMINI_EVALUATION_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GEMINI_TIMEOUT_SECONDS=60
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=200
# Firebase project whose sign-in tokens the API accepts (match VITE_FIREBASE_PROJECT_ID)
FIREBASE_PROJECT_ID=ai-evaluation-40c8a
PORT=8000
# Speech-to-text: whisper (local, open source) | gemini | off
STT_PROVIDER=whisper
# tiny.en, base.en (default), small.en (more accurate, slower)
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en
# Spoken questions (Piper, local neural text-to-speech): piper | off
TTS_PROVIDER=piper
PIPER_VOICE=en_US-lessac-medium
PIPER_LENGTH_SCALE=1.05
MAX_SESSION_RECORDING_MB=800
# Proctoring: violations (leaving the interview) before it ends automatically
PROCTORING_MAX_VIOLATIONS=5
